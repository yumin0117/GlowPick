# 이전 Python 로컬 회귀 시험 전용. 현재 HF Static은 이 파일을 읽지 않습니다.
# Static 화면에서는 사용자가 분석할 때마다 키를 입력합니다. HF에 이 파일을 올리지 마세요.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# live가 기본. mock은 화면/API 연동 시험 전용이며 실제 판독을 하지 않습니다.
GLOWPICK_MODE=live
GEMINI_TIMEOUT_SECONDS=45
GLOWPICK_MAX_REQUESTS_PER_MINUTE=6
# 원응답 기록은 기본 꺼짐. 켜는 경우 공개 저장소/Gradio 제공 디렉터리 밖 절대경로 사용.
GLOWPICK_PRIVATE_RUN_DIR=
