{
  "type": "object",
  "description": "GlowPick 화장품 라벨 분석 응답 (초안 v0.1)",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "not_label", "unreadable", "safety_warning", "out_of_scope"],
      "description": "ok=정상 분석, partial=일부만 읽음, not_label=전성분 라벨이 아님, unreadable=글자를 읽을 수 없음, safety_warning=심한 증상으로 진료 안내, out_of_scope=답변 범위 밖"
    },
    "notice": {
      "type": "string",
      "description": "사용자에게 먼저 보여줄 안내 문구. 없으면 빈 문자열"
    },
    "image_check": {
      "type": "object",
      "properties": {
        "is_ingredient_label": { "type": "boolean", "description": "사진이 전성분 라벨인지" },
        "readable": { "type": "string", "enum": ["full", "partial", "none"], "description": "전성분 글자를 읽은 정도" },
        "issue": { "type": "string", "description": "흐림, 잘림, 빛 반사 등 문제. 없으면 빈 문자열" }
      },
      "required": ["is_ingredient_label", "readable", "issue"]
    },
    "product_name_read": {
      "type": "string",
      "description": "사진에서 읽은 제품명. 보이지 않으면 빈 문자열"
    },
    "ingredients_read": {
      "type": "array",
      "items": { "type": "string" },
      "description": "사진에서 실제로 읽은 전성분, 라벨 순서대로. 추측 금지"
    },
    "summary": {
      "type": "string",
      "description": "전체 성분 구성과 피부 고민 기준 한 줄~세 줄 요약"
    },
    "helpful": {
      "type": "array",
      "maxItems": 5,
      "description": "도움 성분 (라벨에 있는 성분만)",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "reason": { "type": "string" },
          "related_concern": { "type": "string" },
          "source": { "type": "string", "description": "참고 자료 출처 또는 '일반 지식'" }
        },
        "required": ["name", "reason", "related_concern", "source"]
      }
    },
    "caution": {
      "type": "array",
      "maxItems": 5,
      "description": "주의 성분 (라벨에 있는 성분만)",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "reason": { "type": "string" },
          "related_concern": { "type": "string" },
          "source": { "type": "string" }
        },
        "required": ["name", "reason", "related_concern", "source"]
      }
    },
    "complement": {
      "type": "array",
      "maxItems": 5,
      "description": "보완 성분 (라벨에 없는 성분만)",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "reason": { "type": "string" },
          "related_concern": { "type": "string" },
          "source": { "type": "string" }
        },
        "required": ["name", "reason", "related_concern", "source"]
      }
    },
    "product_tips": {
      "type": "array",
      "items": { "type": "string" },
      "description": "성분 기준 제품 선택 팁. 제품명 없이"
    },
    "recommended_products": {
      "type": "array",
      "description": "[참고 제품]이 주어진 경우에만 채움. 없으면 빈 배열",
      "items": {
        "type": "object",
        "properties": {
          "product_name": { "type": "string" },
          "reason": { "type": "string" },
          "source": { "type": "string" }
        },
        "required": ["product_name", "reason", "source"]
      }
    }
  },
  "required": [
    "status", "notice", "image_check", "product_name_read", "ingredients_read",
    "summary", "helpful", "caution", "complement", "product_tips", "recommended_products"
  ]
}
